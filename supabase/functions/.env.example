# Edge function secrets — copy to .env and fill, then:
#   supabase secrets set --env-file supabase/functions/.env

# Required by all functions (send-push, telegram-bot, telegram-notify)
SUPABASE_URL=https://bchojnitamkmnxvwqtdn.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Telegram — create the bot via @BotFather (see README.md in this folder)
TELEGRAM_BOT_TOKEN=
# Public channel the bot posts new listings to; the bot must be an admin there.
TELEGRAM_CHANNEL_ID=@addisfurnish_listings
# Shared secret passed to setWebhook and sent back by Telegram on every update.
# Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Public app origin — used to link alerts and channel posts back to a listing.
SITE_URL=https://addisfurnish.vercel.app

# Cloudinary (cloudinary-sign: listing photos, showcase videos, shop logos).
# Cloud name + API key are public; the API secret must NEVER reach a client.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional — Expo push API scoping (https://expo.dev/settings/access-tokens)
EXPO_ACCESS_TOKEN=
