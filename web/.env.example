# Web app environment variables (copy to .env)
# Supabase project: bchojnitamkmnxvwqtdn

# Public project URL (Project Settings → API)
VITE_SUPABASE_URL=https://bchojnitamkmnxvwqtdn.supabase.co

# Public publishable/anon key (Project Settings → API → Publishable key)
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only (SSR/admin). NEVER expose in client bundles.
SUPABASE_SERVICE_ROLE_KEY=

# Also available via process.env on the server (same values as above)
SUPABASE_URL=https://bchojnitamkmnxvwqtdn.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Production origin, no trailing slash. Social platforms reject a relative
# og:image, so without this the link preview shows no picture.
VITE_SITE_URL=https://addisfurnish.vercel.app

# Optional — makes the "Android APK" download button always point at the
# newest EAS build. Create an Expo access token (expo.dev → Settings → Access
# tokens) and export it here. Without it, /api/latest-apk falls back to the
# pinned latest APK URL (refresh web/src/routes/api.latest-apk.ts after each
# new build).
EXPO_TOKEN=
